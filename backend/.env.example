APP_ENV=development

# Local simple : SQLite.
DATABASE_URL=sqlite:///./staelle.db

# Docker/production : utiliser plutôt DATABASE_HOST + DATABASE_PASSWORD_FILE.
# DATABASE_HOST=db
# DATABASE_PORT=3306
# DATABASE_NAME=staelle_market
# DATABASE_USER=staelle
# DATABASE_PASSWORD_FILE=/run/secrets/db_password

JWT_SECRET=change-this-secret-before-production
# JWT_SECRET_FILE=/run/secrets/jwt_secret

ADMIN_API_KEY=change-this-admin-key-before-production
# ADMIN_API_KEY_FILE=/run/secrets/admin_api_key

FRONTEND_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
POINTS_PER_XAF=1000
ADMIN_ACCESS_TOKEN_MINUTES=480
UPLOAD_DIR=./uploads
PUBLIC_MEDIA_BASE_URL=/api/v1/media
MAX_UPLOAD_BYTES=5242880
