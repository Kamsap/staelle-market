Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # L'ancienne adresse reste valable, mais renvoie vers le nouveau nom public.
  RewriteCond %{HTTP_HOST} ^staelle\.wesolve-digital\.fr$ [NC]
  RewriteRule ^ https://staelle-shop-deal.wesolve-digital.fr%{REQUEST_URI} [L,R=301,NE]

  # En production, toutes les pages utilisent le certificat Let's Encrypt.
  # La redirection conserve le domaine, le chemin et les paramètres demandés.
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301,NE]

  # Si l'API Python est montée sous /api sur le même domaine, on ne réécrit pas
  # ces URLs vers index.html.
  RewriteRule ^api($|/) - [L]

  # Angular est une single-page app : toutes les routes non-fichiers reviennent
  # vers index.html.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
